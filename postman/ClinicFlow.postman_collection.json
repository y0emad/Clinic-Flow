{
  "info": {
    "name": "ClinicFlow API",
    "description": "Clinic appointment booking API for one doctor.\n\nHow to use:\n1. Fill `doctorEmail` / `doctorPassword` in the collection Variables (same values as DOC_EMAIL / DOC_PASS in .env).\n2. Run **Auth → Login (Doctor)** and **Auth → Login (Patient)**: tokens are saved automatically.\n3. **Services → Get all services** saves the first `serviceId`; **Availability** saves the first free slot to `slotStartAt`.\n4. **Book appointment** saves `appointmentId` for cancel / status.\n\nAll times are UTC ISO strings; the clinic works in Africa/Cairo time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "doctorEmail",
      "value": ""
    },
    {
      "key": "doctorPassword",
      "value": ""
    },
    {
      "key": "patientEmail",
      "value": "patient@example.com"
    },
    {
      "key": "patientPassword",
      "value": "123456"
    },
    {
      "key": "doctorToken",
      "value": ""
    },
    {
      "key": "patientToken",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "date",
      "value": "2026-11-07"
    },
    {
      "key": "slotStartAt",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    },
    {
      "key": "timeOffId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up (Patient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Creates a PATIENT account and emails a 6-digit OTP (valid 10 minutes).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Patient\",\n  \"email\": \"{{patientEmail}}\",\n  \"phone\": \"01012345678\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Put the OTP from the email here. The account can't log in until it's verified.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (Patient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.token) {",
                  "  pm.collectionVariables.set(\"patientToken\", json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Doctor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.token) {",
                  "  pm.collectionVariables.set(\"doctorToken\", json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Who is logged in. Switch the token to {{doctorToken}} to test as the doctor.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Emails a 6-digit OTP (valid 10 minutes, 1 per minute). Always answers the same, even for unknown emails.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Put the OTP from the email. 5 wrong tries lock the OTP; request a new one.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"otp\": \"123456\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users (Doctor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get all services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            },
            "description": "Public. Only active services.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.services && json.services[0] && json.services[0].id) {",
                  "  pm.collectionVariables.set(\"serviceId\", json.services && json.services[0] && json.services[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get service by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/{{serviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "{{serviceId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create service (Doctor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Consultation\",\n  \"description\": \"First visit\",\n  \"durationMinutes\": 30,\n  \"price\": 300\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.service && json.service.id) {",
                  "  pm.collectionVariables.set(\"serviceId\", json.service && json.service.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update service (Doctor)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/{{serviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "{{serviceId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 350\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete service (Doctor)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/{{serviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "{{serviceId}}"
              ]
            },
            "description": "Soft delete: the service becomes inactive, old appointments keep it.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Schedule",
      "item": [
        {
          "name": "Get working hours",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedule/working-hours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedule",
                "working-hours"
              ]
            },
            "description": "Public. dayOfWeek: 0 = Sunday … 6 = Saturday.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Set working hours (Doctor)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedule/working-hours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedule",
                "working-hours"
              ]
            },
            "description": "Replaces the whole week. Times are clinic local time (Africa/Cairo).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": [\n    {\n      \"dayOfWeek\": 0,\n      \"startTime\": \"15:00\",\n      \"endTime\": \"18:00\"\n    },\n    {\n      \"dayOfWeek\": 6,\n      \"startTime\": \"16:00\",\n      \"endTime\": \"22:00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get time off (Doctor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedule/time-off",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedule",
                "time-off"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create time off (Doctor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedule/time-off",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedule",
                "time-off"
              ]
            },
            "description": "Max 30 days. endAt must be in the future and after startAt.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startAt\": \"2026-11-20T08:00:00.000Z\",\n  \"endAt\": \"2026-11-21T20:00:00.000Z\",\n  \"reason\": \"Conference\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.timeOff && json.timeOff.id) {",
                  "  pm.collectionVariables.set(\"timeOffId\", json.timeOff && json.timeOff.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete time off (Doctor)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedule/time-off/{{timeOffId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedule",
                "time-off",
                "{{timeOffId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "Get free slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/availability/{{serviceId}}?date={{date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "availability",
                "{{serviceId}}"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "YYYY-MM-DD, today up to 60 days ahead",
                  "disabled": false
                }
              ]
            },
            "description": "Public. Free slots every 15 minutes, minus booked appointments, time off and past times.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.slots && json.slots[0] && json.slots[0].startAt) {",
                  "  pm.collectionVariables.set(\"slotStartAt\", json.slots && json.slots[0] && json.slots[0].startAt);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book appointment (Patient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "startAt must be one of the free slots. Limits: 1 appointment per day, max 3 upcoming, 10 booking attempts per hour. Sends a confirmation email.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"startAt\": \"{{slotStartAt}}\",\n  \"notes\": \"First visit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json.appointment && json.appointment.id) {",
                  "  pm.collectionVariables.set(\"appointmentId\", json.appointment && json.appointment.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My appointments (Patient)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/me?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "me"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "BOOKED",
                  "description": "BOOKED | CANCELLED | COMPLETED | NO_SHOW",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "default 1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "default 10, max 50",
                  "disabled": false
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "All appointments (Doctor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "BOOKED",
                  "description": "BOOKED | CANCELLED | COMPLETED | NO_SHOW",
                  "disabled": true
                },
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "YYYY-MM-DD. Without it: all upcoming appointments",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "default 1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "default 10, max 50",
                  "disabled": false
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Dashboard stats (Doctor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "stats"
              ]
            },
            "description": "Today, upcoming, and this month: completed, no-show, cancelled, revenue, no-show rate %.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel appointment (Patient)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "cancel"
              ]
            },
            "description": "Patient: own appointments only, at least 2 hours before. Sends a cancellation email.",
            "auth": {
