# Copy this file to .env and fill in the values:  cp .env.example .env

# ---- Server ----
PORT=3000
# Frontend origins allowed by CORS (comma-separated). Default: http://localhost:5173 (Vite)
FRONTEND_URL=http://localhost:5173
# Set to true once the site is served over HTTPS (the browser then loads every file over https)
HTTPS_ONLY=false
# Set to true when the app runs behind a reverse proxy (e.g. Caddy), so rate limits see the real visitor IP
TRUST_PROXY=false

# ---- Database ----
# Matches the Postgres container in docker-compose.yml
DATABASE_URL=postgres://ClinicFlow:ClinicFlow@localhost:5432/ClinicFlow

# ---- Auth ----
# At least 32 characters, the server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Email (OTP, booking confirmation, cancellation) ----
# smtp  = nodemailer with EMAIL_HOST/PORT/USER/PASS (Ethereal or Gmail while developing)
# brevo = Brevo HTTP API with BREVO_API_KEY (use this in production: free hosts often block SMTP)
EMAIL_PROVIDER=smtp
# The sender. With Brevo it must be a sender you verified in Brevo (Senders & IPs).
EMAIL_FROM=
EMAIL_FROM_NAME=ClinicFlow
BREVO_API_KEY=

# For development you can use a free Ethereal account: https://ethereal.email
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ---- Doctor account (created by: npm run db:seed) ----
DOC_NAME=
DOC_EMAIL=
DOC_PASS=
DOC_PHONE=
